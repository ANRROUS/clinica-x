# =============================================================================
# .env.railway — Variables de entorno para despliegue en Railway
# =============================================================================
# MÉTODO DE DESPLIEGUE: GitHub Integration (Automático)
# Railway detecta automáticamente los cambios en GitHub y redeploya.
#
# INSTRUCCIONES DE USO:
# 1. NO copies este archivo a .env en cada servicio (no es necesario con GitHub)
# 2. En Railway dashboard, ve a Settings → Variables de cada servicio
# 3. Pega las variables relevantes de este archivo
# 4. Las variables sensibles (contraseñas, tokens) configúralas como "Secrets"
#
# IMPORTANTE: En Railway, los servicios se comunican entre sí usando el nombre
# del servicio como hostname. Ejemplo:
#   AUTH_SERVICE_URL=http://auth-service.railway.internal:3000
#
# Railway también inyecta automáticamente la variable PORT.
# =============================================================================

# =============================================================================
# 1. SUPABASE (Base de Datos Compartida)
# =============================================================================
# Misma instancia de Supabase para todos los servicios.
# Cada servicio apunta a un schema diferente.

SUPABASE_URL=https://jwcfqgvfvkszsqeejewz.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIs...

# --- auth-service ---
AUTH_DATABASE_URL=postgresql://postgres:password@db.jwcfqgvfvkszsqeejewz.supabase.co:6543/postgres?schema=auth_service&pgbouncer=true&sslmode=require
AUTH_DIRECT_URL=postgresql://postgres:password@db.jwcfqgvfvkszsqeejewz.supabase.co:5432/postgres?schema=auth_service&sslmode=require

# --- appointment-service ---
APPOINTMENT_DATABASE_URL=postgresql://postgres:password@db.jwcfqgvfvkszsqeejewz.supabase.co:6543/postgres?schema=appointment_service&pgbouncer=true&sslmode=require
APPOINTMENT_DIRECT_URL=postgresql://postgres:password@db.jwcfqgvfvkszsqeejewz.supabase.co:5432/postgres?schema=appointment_service&sslmode=require

# --- clinical-service ---
CLINICAL_DATABASE_URL=postgresql://postgres:password@db.jwcfqgvfvkszsqeejewz.supabase.co:6543/postgres?schema=clinical_service&pgbouncer=true&sslmode=require
CLINICAL_DIRECT_URL=postgresql://postgres:password@db.jwcfqgvfvkszsqeejewz.supabase.co:5432/postgres?schema=clinical_service&sslmode=require

# --- file-service ---
FILE_DATABASE_URL=postgresql://postgres:password@db.jwcfqgvfvkszsqeejewz.supabase.co:6543/postgres?schema=file_service&pgbouncer=true&sslmode=require
FILE_DIRECT_URL=postgresql://postgres:password@db.jwcfqgvfvkszsqeejewz.supabase.co:5432/postgres?schema=file_service&sslmode=require

# --- ocr-service (comparte schema clinical_service) ---
OCR_DATABASE_URL=postgresql://postgres:password@db.jwcfqgvfvkszsqeejewz.supabase.co:6543/postgres?schema=clinical_service&pgbouncer=true&sslmode=require
OCR_DIRECT_URL=postgresql://postgres:password@db.jwcfqgvfvkszsqeejewz.supabase.co:5432/postgres?schema=clinical_service&sslmode=require

# =============================================================================
# 2. JWT (Compartido entre todos los servicios)
# =============================================================================
# Todos los servicios DEBEN usar el MISMO JWT_SECRET.
# Genera uno seguro con: openssl rand -base64 32

JWT_SECRET=cambia_esto_por_un_secreto_seguro_de_32_caracteres_minimo
JWT_EXPIRES_IN=1d

# =============================================================================
# 3. SUPABASE STORAGE (file-service + ocr-service)
# =============================================================================
SUPABASE_BUCKET=clinica-x-archivos
MAX_FILE_SIZE_BYTES=10485760
ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png

# =============================================================================
# 4. OCR (ocr-service)
# =============================================================================
OCR_SPACE_API_KEY=tu_api_key_de_ocr_space
OCR_SPACE_API_URL=https://api.ocr.space/parse/image
OCR_SPACE_ENGINE=2
OCR_SPACE_LANGUAGE=spa

# =============================================================================
# 5. IA / OPENAI (clinical-service)
# =============================================================================
AI_ENABLED=false
OPENAI_API_KEY=sk-...
AI_TIMEOUT_MS=20000

# =============================================================================
# 6. URLs DE SERVICIOS (Railway Internal Networking)
# =============================================================================
# En Railway, los servicios se comunican vía railway.internal
# Reemplaza 'clinica-x' con tu project name en Railway si es diferente.

AUTH_SERVICE_URL=http://auth-service.railway.internal:3000
APPOINTMENT_SERVICE_URL=http://appointment-service.railway.internal:3001
CLINICAL_SERVICE_URL=http://clinical-service.railway.internal:3002
FILE_SERVICE_URL=http://file-service.railway.internal:3003
OCR_SERVICE_URL=http://ocr-service.railway.internal:3004

# =============================================================================
# 7. FRONTEND (Next.js)
# =============================================================================
# URL pública del API Gateway en Railway (se obtiene después del deploy)
NEXT_PUBLIC_API_BASE_URL=https://api-gateway-tu-proyecto.up.railway.app

# URL del frontend (para emails de recuperación)
FRONTEND_URL=https://frontend-tu-proyecto.up.railway.app

# =============================================================================
# 8. API GATEWAY
# =============================================================================
# Origen del frontend para CORS (en producción)
CORS_ORIGIN=https://frontend-tu-proyecto.up.railway.app

# =============================================================================
# 9. EMAIL / RECUPERACIÓN DE CONTRASEÑA (auth-service)
# =============================================================================
SUPABASE_EDGE_FUNCTION_URL=https://jwcfqgvfvkszsqeejewz.supabase.co/functions/v1
INTERNAL_EMAIL_SECRET=cambia_esto_por_un_secreto_para_emails

# =============================================================================
# 10. OTROS
# =============================================================================
NODE_ENV=production
