# =============================================================================
# .env.example — Plantilla de variables de entorno para Clínica X
# =============================================================================
# Copia este archivo a `.env` y reemplaza los valores con tus credenciales.
# El archivo `.env` está en .gitignore y NO debe ser comiteado.
# =============================================================================

# --- Bind de Docker (solo localhost por seguridad) ---
HOST_BIND_IP=127.0.0.1

# --- Puertos host ---
HOST_AUTH_PORT=3000
HOST_APPOINTMENT_PORT=3001
HOST_CLINICAL_PORT=3002
HOST_FILE_PORT=3003
HOST_GATEWAY_PORT=8080

# --- JWT (compartido entre todos los servicios y el gateway) ---
JWT_SECRET=change_this_secret
JWT_EXPIRES_IN=1d

# --- Supabase Postgres: URLs por servicio (pooler + directo para Prisma) ---
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DB?schema=NOMBRE_SCHEMA&...
AUTH_DATABASE_URL="postgresql://user:password@host:6543/postgres?schema=auth_service&pgbouncer=true&sslmode=require"
AUTH_DIRECT_URL="postgresql://user:password@host:5432/postgres?schema=auth_service&sslmode=require"

APPOINTMENT_DATABASE_URL="postgresql://user:password@host:6543/postgres?schema=appointment_service&pgbouncer=true&sslmode=require"
APPOINTMENT_DIRECT_URL="postgresql://user:password@host:5432/postgres?schema=appointment_service&sslmode=require"

CLINICAL_DATABASE_URL="postgresql://user:password@host:6543/postgres?schema=clinical_service&pgbouncer=true&sslmode=require"
CLINICAL_DIRECT_URL="postgresql://user:password@host:5432/postgres?schema=clinical_service&sslmode=require"

FILE_DATABASE_URL="postgresql://user:password@host:6543/postgres?schema=file_service&pgbouncer=true&sslmode=require"
FILE_DIRECT_URL="postgresql://user:password@host:5432/postgres?schema=file_service&sslmode=require"

# --- IA (clinical-service) ---
OPENAI_API_KEY=sk-...
AI_TIMEOUT_MS=20000

# --- AWS S3 (file-service) ---
AWS_REGION=us-east-1
AWS_BUCKET=clinica-x-archivos
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
