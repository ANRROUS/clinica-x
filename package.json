{
  "name": "clinica-x",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo Clínica X — Microservicios con Arquitectura Hexagonal + DDD",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "postinstall": "pnpm -r --filter \"@clinica-x/*\" run build",
    "build": "pnpm -r --filter \"@clinica-x/*\" --filter \"./services/*\" run build",
    "dev": "concurrently --kill-others --names services,ai,frontend --prefix-colors cyan,green,blue \"pnpm dev:services\" \"pnpm dev:ai\" \"pnpm dev:frontend\"",
    "dev:services": "pnpm -r --parallel --filter \"./services/*\" run dev",
    "dev:auth": "pnpm --filter auth-service dev",
    "dev:appointment": "pnpm --filter appointment-service dev",
    "dev:clinical": "pnpm --filter clinical-service dev",
    "dev:file": "pnpm --filter file-service dev",
    "dev:gateway": "pnpm --filter api-gateway dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:ai": "cd services\\ai-service && .venv\\Scripts\\python.exe -m uvicorn src.main:app --reload --port 3005",
    "dev:ai:install": "cd services\\ai-service && python -m venv .venv && .venv\\Scripts\\pip.exe install -r requirements.txt",
    "lint": "pnpm -r run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\" --ignore-path .gitignore",
    "prisma:generate:all": "pnpm --filter auth-service prisma:generate && pnpm --filter appointment-service prisma:generate && pnpm --filter clinical-service prisma:generate && pnpm --filter file-service prisma:generate && pnpm --filter ocr-service prisma:generate",
    "prisma:migrate:all": "pnpm --filter auth-service prisma:migrate && pnpm --filter appointment-service prisma:migrate && pnpm --filter clinical-service prisma:migrate && pnpm --filter file-service prisma:migrate",
    "db:reset": "node scripts/clean-schemas.js",
    "seed:demo": "node scripts/seed-demo.js",
    "seed:all": "pnpm --filter auth-service seed && pnpm --filter appointment-service seed && node scripts/seed-demo.js",
    "test:e2e": "node scripts/test-e2e.js",
    "test:selenium": "pnpm --filter @clinica-x/tests-selenium test",
    "test:selenium:paciente": "pnpm --filter @clinica-x/tests-selenium test:paciente",
    "test:selenium:paciente:login": "pnpm --filter @clinica-x/tests-selenium test:paciente:login",
    "test:selenium:paciente:registro": "pnpm --filter @clinica-x/tests-selenium test:paciente:registro",
    "test:selenium:paciente:manual": "pnpm --filter @clinica-x/tests-selenium test:paciente:manual",
    "test:selenium:paciente:auto": "pnpm --filter @clinica-x/tests-selenium test:paciente:auto",
    "test:selenium:paciente:perfil": "pnpm --filter @clinica-x/tests-selenium test:paciente:perfil",
    "test:selenium:paciente:cancelar": "pnpm --filter @clinica-x/tests-selenium test:paciente:cancelar",
    "test:selenium:paciente:reprogramar": "pnpm --filter @clinica-x/tests-selenium test:paciente:reprogramar",
    "test:selenium:paciente:login-unhappy": "pnpm --filter @clinica-x/tests-selenium test:paciente:login-unhappy",
    "test:selenium:paciente:registro-unhappy": "pnpm --filter @clinica-x/tests-selenium test:paciente:registro-unhappy",
    "test:selenium:firefox": "pnpm --filter @clinica-x/tests-selenium test:firefox",
    "test:selenium:firefox:login": "pnpm --filter @clinica-x/tests-selenium test:firefox:login",
    "test:selenium:firefox:reprogramar": "pnpm --filter @clinica-x/tests-selenium test:firefox:reprogramar",
    "test:selenium:firefox:login-unhappy": "pnpm --filter @clinica-x/tests-selenium test:firefox:login-unhappy",
    "test:selenium:mobile": "pnpm --filter @clinica-x/tests-selenium test:mobile",
    "test:selenium:mobile:android": "pnpm --filter @clinica-x/tests-selenium test:mobile:android",
    "test:selenium:mobile:ios": "pnpm --filter @clinica-x/tests-selenium test:mobile:ios",
    "test:selenium:mobile:android:login": "pnpm --filter @clinica-x/tests-selenium test:mobile:android:login",
    "test:selenium:mobile:android:reserva": "pnpm --filter @clinica-x/tests-selenium test:mobile:android:reserva",
    "test:selenium:mobile:android:consultas": "pnpm --filter @clinica-x/tests-selenium test:mobile:android:consultas",
    "test:selenium:mobile:android:cancelar": "pnpm --filter @clinica-x/tests-selenium test:mobile:android:cancelar",
    "test:selenium:mobile:ios:login": "pnpm --filter @clinica-x/tests-selenium test:mobile:ios:login",
    "test:selenium:mobile:ios:reserva": "pnpm --filter @clinica-x/tests-selenium test:mobile:ios:reserva",
    "test:selenium:mobile:ios:consultas": "pnpm --filter @clinica-x/tests-selenium test:mobile:ios:consultas",
    "test:selenium:mobile:ios:cancelar": "pnpm --filter @clinica-x/tests-selenium test:mobile:ios:cancelar",
    "test:selenium:medico": "pnpm --filter @clinica-x/tests-selenium test:medico",
    "test:selenium:medico:login": "pnpm --filter @clinica-x/tests-selenium test:medico:login",
    "test:selenium:medico:consulta": "pnpm --filter @clinica-x/tests-selenium test:medico:consulta",
    "test:selenium:admin": "pnpm --filter @clinica-x/tests-selenium test:admin",
    "test:selenium:admin:login": "pnpm --filter @clinica-x/tests-selenium test:admin:login",
    "test:selenium:admin:dashboard": "pnpm --filter @clinica-x/tests-selenium test:admin:dashboard",
    "test:selenium:admin:agregar-doctor": "pnpm --filter @clinica-x/tests-selenium test:admin:agregar-doctor",
    "test:selenium:admin:editar-doctor": "pnpm --filter @clinica-x/tests-selenium test:admin:editar-doctor",
    "test:selenium:admin:desactivar-doctor": "pnpm --filter @clinica-x/tests-selenium test:admin:desactivar-doctor",
    "test:selenium:admin:dni-duplicado": "pnpm --filter @clinica-x/tests-selenium test:admin:dni-duplicado",
    "test:usabilidad": "pnpm --filter @clinica-x/test-usabilidad test:all",
    "test:usabilidad:lighthouse": "pnpm --filter @clinica-x/test-usabilidad lighthouse",
    "test:usabilidad:pagespeed": "pnpm --filter @clinica-x/test-usabilidad pagespeed",
    "test:usabilidad:report": "pnpm --filter @clinica-x/test-usabilidad report",
    "test:usabilidad:pdf": "pnpm --filter @clinica-x/test-usabilidad pdf",
    "test:usabilidad:all:pdf": "pnpm --filter @clinica-x/test-usabilidad test:all:pdf"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "concurrently": "^10.0.3",
    "pg": "^8.12.0",
    "prettier": "^3.2.0",
    "typescript": "^5.4.0"
  }
}