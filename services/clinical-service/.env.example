PORT=3002
DATABASE_URL="postgresql://user:password@host:6543/postgres?schema=clinical_service&pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/postgres?schema=clinical_service&sslmode=require"
JWT_SECRET=change_this_secret

# --- IA "Agente X" ---
# AI_ENABLED=false → endpoint /api/medical/.../ai/chat devuelve { status: "coming_soon" }
# Cuando esté listo: cambiar a true y poner una OPENAI_API_KEY válida.
AI_ENABLED=false
OPENAI_API_KEY=sk-...
AI_TIMEOUT_MS=20000

# --- URLs cross-service ---
AUTH_SERVICE_URL=http://localhost:3000
APPOINTMENT_SERVICE_URL=http://localhost:3001
FILE_SERVICE_URL=http://localhost:3003
