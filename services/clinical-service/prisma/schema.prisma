// Schema Postgres: clinical_service
// Tablas a definir: consultas, diagnosticos, recetas, medicamentos,
// ordenes_analisis, resultados_analisis, mensajes_chat_ia.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

