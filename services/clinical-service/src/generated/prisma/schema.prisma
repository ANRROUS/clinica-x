// =============================================================================
// clinical-service — Prisma schema
// =============================================================================
// Schema Postgres: clinical_service
// =============================================================================

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Consulta médica ─────────────────────────────────────────────────────────
model Consulta {
  id             String    @id @default(uuid())
  pacienteId     String
  medicoId       String
  citaId         String? // Referencia opcional a cita en appointment-service
  estado         String // ACTIVA | FINALIZADA
  motivoConsulta String?
  diagnostico    String?
  notas          String?
  fechaInicio    DateTime  @default(now())
  fechaFin       DateTime?
  creadoEn       DateTime  @default(now())
  actualizadoEn  DateTime  @updatedAt

  ordenesAnalisis OrdenAnalisis[]

  @@map("consultas")
}

// ─── Orden de análisis clínico ───────────────────────────────────────────────
model OrdenAnalisis {
  id            String   @id @default(uuid())
  consultaId    String
  consulta      Consulta @relation(fields: [consultaId], references: [id])
  tipoAnalisis  String
  descripcion   String?
  estado        String // PENDIENTE | COMPLETADA
  resultado     String?
  archivoId     String? // Referencia al archivo en file-service
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@map("ordenes_analisis")
}
