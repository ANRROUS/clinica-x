# Variables de entorno para ai-service (Agente X)
PORT=3005

# JWT — debe coincidir con el JWT_SECRET del api-gateway
JWT_SECRET=change_this_secret

# Gemini API — clave para el modelo de IA
GEMINI_API_KEY=tu_gemini_api_key_aqui
GEMINI_MODEL=gemini-1.5-flash
GEMINI_MODEL_PRO=gemini-1.5-pro

# Timeout de IA en milisegundos
AI_TIMEOUT_MS=30000

# URLs de servicios (ai-service solo habla via HTTP)
CLINICAL_SERVICE_URL=http://localhost:3002
AUTH_SERVICE_URL=http://localhost:3000
APPOINTMENT_SERVICE_URL=http://localhost:3001
INTERNAL_API_KEY=internal-dev-key-change-in-prod

# Conexión directa a BD solo para chat_messages (schema chat_service)
DATABASE_URL=postgresql://<user>:<password>@<host>:6543/postgres?schema=chat_service&pgbouncer=true&sslmode=require
DIRECT_URL=postgresql://<user>:<password>@<host>:5432/postgres?schema=chat_service&sslmode=require
