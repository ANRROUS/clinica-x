PORT=3003
DATABASE_URL="postgresql://user:password@host:6543/postgres?schema=file_service&pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/postgres?schema=file_service&sslmode=require"
JWT_SECRET=change_this_secret

# --- AWS S3 ---
AWS_REGION=us-east-1
AWS_BUCKET=clinica-x-archivos
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...

# Tamaño máximo permitido y MIME types (defaults; opcional)
MAX_FILE_SIZE_BYTES=10485760
ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png
