// =============================================================================
// file-service — Prisma schema
// =============================================================================
// Schema Postgres: file_service
// =============================================================================

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Archivo subido a S3 ─────────────────────────────────────────────────────
model Archivo {
  id                   String   @id @default(uuid())
  propietarioServicio  String   // Ej: 'clinical-service', 'auth-service'
  propietarioRecursoId String   // ID del recurso al que pertenece
  bucket               String
  keyS3                String   @unique
  nombreOriginal       String
  mimeType             String
  tamanoBytes          Int
  subidoEn             DateTime @default(now())

  @@map("archivos")
}
