// =============================================================================
// appointment-service — Prisma schema
// =============================================================================
// Schema Postgres: appointment_service
// Tablas a definir en fases posteriores: medicos, horarios_medico,
// especialidades, citas, vouchers.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── PLACEHOLDER (Fase 0) — eliminar en Fase 2 ──────────────────────────────
model Placeholder {
  id String @id @default(uuid())

  @@map("_placeholder_fase0")
}
