{
  "name": "appointment-service",
  "version": "0.1.0",
  "private": true,
  "description": "Servicio de agendamiento de Clínica X — gestiona médicos, horarios y citas",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json && pnpm postbuild:prisma",
    "postbuild:prisma": "cpx \"src/generated/prisma/**/*\" dist/generated/prisma",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "lint": "eslint src --ext .ts",
    "clean": "rimraf dist",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@clinica-x/date-utils": "workspace:*",
    "@clinica-x/shared-kernel": "workspace:*",
    "@clinica-x/shared-middleware": "workspace:*",
    "@clinica-x/shared-types": "workspace:*",
    "@prisma/client": "^5.18.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.2.1",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "pino-roll": "^4.0.0",
    "@scalar/express-api-reference": "^0.9.20",
    "swagger-jsdoc": "^6.3.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.11.0",
    "@types/node-cron": "^3.0.11",
    "@types/swagger-jsdoc": "^6.0.4",
    "cpx2": "^9.0.0",
    "prisma": "^5.18.0",
    "rimraf": "^5.0.0",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}