// =============================================================================
// auth-service — Prisma schema
// =============================================================================
// Schema Postgres: auth_service
// =============================================================================

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enum de roles del sistema ──────────────────────────────────────────────
// Coincide con el enum Rol de @clinica-x/shared-types
enum Rol {
  PACIENTE
  MEDICO
  ADMIN
}

// ─── Entidad Usuario ────────────────────────────────────────────────────────
model Usuario {
  id            String   @id @default(uuid())
  dni           String   @unique
  email         String   @unique
  passwordHash  String   @map("password_hash")
  nombre        String
  apellido      String
  telefono      String?
  rol           Rol      @default(PACIENTE)
  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@map("usuarios")
}
