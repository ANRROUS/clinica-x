PORT=8080

# URLs internas hacia cada microservicio
AUTH_SERVICE_URL=http://localhost:3000
APPOINTMENT_SERVICE_URL=http://localhost:3001
CLINICAL_SERVICE_URL=http://localhost:3002
FILE_SERVICE_URL=http://localhost:3003

# Mismo secret que comparten todos los servicios
JWT_SECRET=change_this_secret

# Origen permitido para CORS (front local). Acepta múltiples separados por coma.
CORS_ORIGIN=http://localhost:3100
