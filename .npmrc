# pnpm: configuración global del workspace.
auto-install-peers=true
strict-peer-dependencies=false

# Permitir que estos paquetes ejecuten sus scripts postinstall
public-hoist-pattern[]=*prisma*
public-hoist-pattern[]=@prisma/*
public-hoist-pattern[]=*types*

# Permitir build scripts de dependencias nativas
onlyBuiltDependencies[]=@prisma/client
onlyBuiltDependencies[]=@prisma/engines
onlyBuiltDependencies[]=prisma
onlyBuiltDependencies[]=esbuild
onlyBuiltDependencies[]=unrs-resolver
